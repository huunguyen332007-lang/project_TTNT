# Để trống = gọi API cùng domain (/api) - cách dùng mặc định, qua Vite proxy khi dev và qua nginx khi deploy.
# Chỉ điền khi backend nằm ở domain khác, ví dụ https://api.example.com (backend phải bật CORS cho domain frontend).
VITE_API_URL=

# Chỉ dùng cho `npm run dev`: địa chỉ backend mà Vite proxy tới.
VITE_PROXY_TARGET=http://localhost:3000
