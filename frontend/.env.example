# false = dùng dữ liệu mẫu trong src/data.js (không cần backend)
# true  = gọi POST /api/recommend của backend
VITE_USE_API=false

# Để trống nếu frontend và backend cùng domain (Vite proxy / nginx).
VITE_API_URL=

# Backend NodeJS khi chạy dev (dùng cho Vite proxy)
VITE_PROXY_TARGET=http://localhost:3000
