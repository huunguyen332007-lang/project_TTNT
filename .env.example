# Sao chép thành .env (cùng thư mục với docker-compose). KHÔNG commit file .env.
# - Chạy local: có thể bỏ qua, docker-compose.yml đã có giá trị mặc định.
# - Production: BẮT BUỘC đặt POSTGRES_PASSWORD và ADMIN_API_KEY.

POSTGRES_DB=ttnt
POSTGRES_USER=ttnt
# Dùng mật khẩu chỉ gồm chữ và số (nó nằm trong DATABASE_URL). Tạo nhanh:  openssl rand -hex 24
POSTGRES_PASSWORD=doi-mat-khau-nay

# Khóa cho endpoint quản trị (>= 16 ký tự). Tạo nhanh:  openssl rand -hex 24
ADMIN_API_KEY=

# --- Chỉ dùng cho production ---
# Tên miền trỏ về server (Caddy tự cấp HTTPS). Chưa có tên miền thì dùng :80
DOMAIN=:80
# Tự đồng bộ CSV marketplace-products.csv vào PostgreSQL mỗi lần backend khởi động.
IMPORT_CSV_ON_START=true
