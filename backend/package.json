{
  "name": "ttnt-backend",
  "version": "2.0.0",
  "description": "API tìm kiếm & gợi ý sản phẩm (embedding văn bản + ảnh, PostgreSQL/pgvector)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/scripts/migrate.js",
    "reindex": "node --env-file-if-exists=.env src/scripts/reindex.js",
    "import:csv": "node --env-file-if-exists=.env src/scripts/import-csv.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^2.0.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.24.1"
  }
}
