# Sao chép thành .env khi chạy backend trực tiếp bằng Python.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgres://ttnt:ttnt@localhost:5432/ttnt
DB_POOL_MAX=10
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=30000
# Nguồn embedding: local = AI Service tự host (AI_SERVICE_URL); jina = Jina AI API (không cần AI Service).
EMBEDDING_PROVIDER=local
JINA_API_KEY=
JINA_MODEL=jina-clip-v2
# Gói free ~100 request/phút và 100.000 token/phút; mỗi ảnh ~4.000 token. Đặt 0 nếu dùng key trả phí.
JINA_IMAGE_INTERVAL_MS=2500
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ADMIN_API_KEY=
RUN_MIGRATIONS=true
IMPORT_CSV_ON_START=true
TRUST_PROXY=0
MAX_UPLOAD_MB=5
RATE_LIMIT_PER_MIN=120
SEARCH_RATE_LIMIT_PER_MIN=30
TEXT_MIN_SIMILARITY=0
IMAGE_MIN_SIMILARITY=0
TEXT_IMAGE_WEIGHT=0.3
