# Sao chép thành .env khi chạy backend trực tiếp bằng `npm run dev`.
# Khi chạy bằng docker compose, các biến này được khai báo trong docker-compose.yml.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# PostgreSQL (cần extension pgvector - dùng image pgvector/pgvector:pg16)
DATABASE_URL=postgres://ttnt:ttnt@localhost:5432/ttnt
DB_POOL_MAX=10

# Dịch vụ AI (FastAPI) tạo embedding
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=30000

# Danh sách origin được phép gọi API (phân tách bằng dấu phẩy). Để trống = chỉ same-origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Khóa cho các endpoint quản trị (tạo/xóa sản phẩm, reindex). Tối thiểu 16 ký tự.
# Bỏ trống = các endpoint quản trị bị tắt.
ADMIN_API_KEY=

# Tự chạy migration và đồng bộ CSV marketplace-products.csv vào PostgreSQL khi backend khởi động.
# 6 sản phẩm mẫu cũ (ảnh Unsplash) còn sót trong DB sẽ tự bị xóa khi import CSV chạy.
RUN_MIGRATIONS=true
IMPORT_CSV_ON_START=true

# Tỉ trọng (0..1) của độ khớp chữ->ảnh khi tìm bằng chữ. 0 = tắt. Chỉ tăng sau khi fine-tune CLIP cho thấy t2i_R@5 cải thiện.
TEXT_IMAGE_WEIGHT=0.3

# Số lớp reverse proxy phía trước backend (0 nếu truy cập trực tiếp)
TRUST_PROXY=0

MAX_UPLOAD_MB=5
RATE_LIMIT_PER_MIN=120
SEARCH_RATE_LIMIT_PER_MIN=30

# Ngưỡng cosine similarity tối thiểu (0 = không lọc). Cần tinh chỉnh theo dữ liệu thật.
TEXT_MIN_SIMILARITY=0
IMAGE_MIN_SIMILARITY=0
